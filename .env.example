# Application environment.
# `dev` enables the X-User-Id auth shortcut and a few opt-in fail-open
# behaviours (e.g. legacy single-bucket OSS fallback). `prod` requires
# real auth and forbids those fallbacks.
APP_ENV=dev

# ────────────────────────────────────────────────────────────────────────
# Datastores
# ────────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://aidrobe:aidrobe@localhost:5432/aidrobe
REDIS_URL=redis://localhost:6379/0
ARQ_REDIS_URL=redis://localhost:6379/1
ARQ_JOB_TIMEOUT_SECONDS=300
ARQ_MAX_JOBS=50
ENABLE_SCHEDULER=false

# ────────────────────────────────────────────────────────────────────────
# Auth (Apple Sign-In + JWT). JWT_SECRET MUST be ≥ 32 bytes in prod.
# ────────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-at-least-32-bytes-value
JWT_ALGORITHM=HS256
JWT_AUDIENCE=aidrobe-api
JWT_ISSUER=aidrobe
JWT_ACCESS_TOKEN_MINUTES=60
JWT_REFRESH_TOKEN_DAYS=30
APPLE_CLIENT_ID=com.example.aidrobe
AUTH_APPLE_VERIFY_SIGNATURE=true
APPLE_JWKS_TIMEOUT_SECONDS=5

# ────────────────────────────────────────────────────────────────────────
# Vision / LLM / embedding / weather providers (set to `fake` / `none`
# in dev to skip real network calls).
# ────────────────────────────────────────────────────────────────────────
VISION_PROVIDER=fake
VISION_MAX_CALLS_PER_USER_HOUR=60
VISION_TIMEOUT_SECONDS=10
QWEN_API_KEY=
QWEN_VISION_MODEL=qwen-vl-max
QWEN_VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions

LLM_PROVIDER=none
OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-5.2
QWEN_LLM_MODEL=qwen-turbo
QWEN_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
LLM_TIMEOUT_SECONDS=3

EMBEDDING_PROVIDER=fake
CLIP_EMBEDDING_API_KEY=
CLIP_EMBEDDING_BASE_URL=https://api.openai.com/v1/embeddings
CLIP_EMBEDDING_TIMEOUT_SECONDS=10

WEATHER_PROVIDER=none
QWEATHER_API_KEY=
QWEATHER_BASE_URL=https://devapi.qweather.com
OPENWEATHER_API_KEY=
WEATHER_CACHE_TTL_SECONDS=3600
WEATHER_TIMEOUT_SECONDS=5

# ────────────────────────────────────────────────────────────────────────
# Object storage. Pick ONE provider via STORAGE_PROVIDER.
#   local      — dev only, writes to LOCAL_STORAGE_ROOT
#   s3         — AWS S3 / S3-compatible (MinIO etc.)
#   aliyun_oss — Aliyun OSS (China prod). Phase E5.
# ────────────────────────────────────────────────────────────────────────
STORAGE_PROVIDER=local
LOCAL_STORAGE_ROOT=/tmp/aidrobe_local_storage
LOCAL_STORAGE_BASE_URL=http://localhost:9000/local

# S3 (or compatible)
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=http://localhost:9000/aidrobe
S3_PRESIGN_EXPIRES_SECONDS=900

# Aliyun OSS — per plan §2.9 four buckets isolate retention/privacy
# policies. `ALIYUN_OSS_BUCKET` is a legacy/dev fallback; prod MUST set
# the per-purpose vars or STS endpoints return 503.
ALIYUN_OSS_REGION=cn-hangzhou
ALIYUN_OSS_ENDPOINT=
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_BUCKET_ITEMS=
ALIYUN_OSS_BUCKET_OOTD=
ALIYUN_OSS_BUCKET_PRIVATE=
ALIYUN_OSS_BUCKET_DERIVED=
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_PUBLIC_BASE_URL=

# Aliyun STS — separate, narrower-scope credentials than OSS service
# account so a leak here doesn't compromise the bucket directly.
ENABLE_OSS_STS=false
ALIYUN_STS_ACCESS_KEY_ID=
ALIYUN_STS_ACCESS_KEY_SECRET=
ALIYUN_STS_ROLE_ARN=
ALIYUN_STS_TTL_SECONDS=900

# CDN signing (optional — leave empty to read direct from OSS via
# bucket.sign_url). Type A signing scheme.
CDN_BASE_URL=
CDN_AUTH_KEY=
CDN_SIGN_TTL_SECONDS=1800

# ────────────────────────────────────────────────────────────────────────
# Observability
# ────────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=console
SENTRY_DSN=
SENTRY_ENVIRONMENT=dev
SENTRY_TRACES_SAMPLE_RATE=0

# ────────────────────────────────────────────────────────────────────────
# Push notifications (APNs)
# ────────────────────────────────────────────────────────────────────────
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
APNS_AUTH_KEY_PATH=
APNS_USE_SANDBOX=true
APNS_TIMEOUT_SECONDS=5

# ────────────────────────────────────────────────────────────────────────
# Misc network
# ────────────────────────────────────────────────────────────────────────
LINK_PARSE_TIMEOUT_SECONDS=5

# ────────────────────────────────────────────────────────────────────────
# Phase B — explainability runtime feature flags. Each pipeline gates
# independently so you can roll out / roll back per concern.
# ────────────────────────────────────────────────────────────────────────
ENABLE_OUTFIT_SCORES=false
ENABLE_OBSTACLES=false
ENABLE_PREP_STEPS=false

# ────────────────────────────────────────────────────────────────────────
# Phase C — async-jobs framework. Dual-write let us migrate workers
# to job_runtime while still emitting legacy events for parity checks.
# ────────────────────────────────────────────────────────────────────────
ASYNC_JOBS_DUAL_WRITE=true

# ────────────────────────────────────────────────────────────────────────
# Phase D — context + refresh. Both default-off so a misconfigured
# weather provider can't leak context, and so refresh is opt-in
# rather than accidental on every deploy.
# ────────────────────────────────────────────────────────────────────────
ENABLE_TODAY_CONTEXT=false
ENABLE_TODAY_REFRESH=false
TODAY_REFRESH_DAILY_LIMIT=3

# ────────────────────────────────────────────────────────────────────────
# Phase E — PIPL soft delete + cost guard + LLM input sanitizer.
# ────────────────────────────────────────────────────────────────────────
# DELETE /v1/me kill switch — default off so a bad rollout can't
# accidentally let users self-destruct. Flip to true after the iOS
# delete-account screen is wired and verified.
ENABLE_USER_PURGE=false
USER_PURGE_GRACE_DAYS=30

# Per-user-per-day cost quotas (enforced when ENABLE_COST_GUARD=true).
ENABLE_COST_GUARD=false
LLM_DAILY_TOKEN_LIMIT=50000
OCR_DAILY_CALL_LIMIT=100
TRYON_DAILY_CALL_LIMIT=5

# HMAC key for the opaque `usr_<22ch>` user token passed to LLM prompts.
# Sanitizer hard-fails in prod if this is the placeholder. ≥ 32 bytes.
LLM_USER_TOKEN_HMAC_KEY=dev-only-change-me-llm-user-token-hmac-key-32b

# M16 Travel Packing List — generate/edit endpoints. Off by default; lists
# persist regardless of the flag, the flag only gates exposure.
ENABLE_PACKING_LIST=false

# Comma-separated UUIDs allowed to hit /v1/admin/*. Empty = fail-open
# in dev (every authenticated user is admin); empty in prod = fail-closed
# (admin surface is locked off).
ADMIN_USER_IDS=

# V4 Outfit Calendar — plan/calendar endpoints. Off by default; plans
# persist regardless of the flag, the flag only gates exposure.
ENABLE_OUTFIT_CALENDAR=false
